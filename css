* { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, sans-serif; }
    body, html { width: 100%; height: 100%; overflow: hidden; background-color: #030712; }

    /* ============ FEJLÉC ============ */
    header {
        position: absolute; top: 0; left: 0; right: 0; height: 70px;
        background: rgba(15, 23, 42, 0.75); backdrop-filter: blur(12px);
        color: white; display: flex; align-items: center; justify-content: space-between;
        padding: 0 25px; z-index: 500; border-bottom: 1px solid rgba(255,255,255,0.08);
    }
    .logo-img { height: 46px; width: auto; display: block; }

    .filter-container {
        display: flex; gap: 8px; background: rgba(0, 0, 0, 0.4);
        padding: 4px; border-radius: 30px; border: 1px solid rgba(255,255,255,0.1);
    }
    .filter-btn {
        background: none; border: none; color: #94a3b8; padding: 8px 16px;
        font-size: 0.85rem; font-weight: 600; border-radius: 20px; cursor: pointer;
        transition: all 0.3s ease;
    }
    .filter-btn.active { background: #38bdf8; color: #0f172a; }
    .filter-btn.btn-gallop.active { background: #ef4444; color: #ffffff; }
    .filter-btn.btn-gallop { opacity: 0.35; cursor: not-allowed; }
    .filter-btn.btn-gallop:hover { background: none; }
    .filter-btn.btn-trot.active { background: #38bdf8; color: #0f172a; }

    /* ================================================================
       LEGÖRDÜLŐ MENÜK (nyelvválasztó + hamburger)
       ================================================================ */
    .dropdown-wrap { position: relative; }
    #langBtn, #hamburgerBtn {
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15);
        color: #94a3b8; font-size: 0.95rem; cursor: pointer; transition: all 0.2s ease;
    }
    #langBtn:hover, #hamburgerBtn:hover { color: #f59e0b; border-color: #f59e0b; background: rgba(245,158,11,0.1); }
    .dropdown-menu {
        display: none; position: absolute; top: 42px; right: 0; z-index: 700;
        background: rgba(15, 23, 42, 0.97); backdrop-filter: blur(10px);
        border: 1px solid rgba(255,255,255,0.15); border-radius: 12px;
        min-width: 160px; padding: 6px; box-shadow: 0 12px 30px -8px rgba(0,0,0,0.7);
        max-height: 320px; overflow-y: auto;
    }
    .dropdown-menu.open { display: block; }
    .dropdown-menu button {
        display: block; width: 100%; text-align: left; background: none; border: none;
        color: #e2e8f0; padding: 9px 12px; font-size: 0.85rem; border-radius: 8px;
        cursor: pointer; white-space: nowrap;
    }
    .dropdown-menu button:hover { background: rgba(56, 189, 248, 0.15); }
    .dd-flag { display: inline-block; width: 22px; }
    .filter-btn:hover:not(.active) { color: #ffffff; }
    .filter-container.disabled { opacity: 0.35; pointer-events: none; }

    .back-btn {
        display: none;
        background: rgba(245, 158, 11, 0.15); border: 1px solid #f59e0b; color: #f59e0b;
        padding: 8px 18px; font-size: 0.85rem; font-weight: 600; border-radius: 20px;
        cursor: pointer; transition: all 0.2s ease;
    }
    .back-btn:hover { background: #f59e0b; color: #0f172a; }
    .back-btn.visible { display: inline-block; }

    /* Kompakt, kör alakú jogi info gomb a fejlécben - mindig látható,
       minimális helyet foglal, nem versenyez a többi gombbal */
    #legalInfoBtn {
        flex-shrink: 0; width: 32px; height: 32px; border-radius: 50%;
        background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.15);
        color: #94a3b8; font-size: 0.95rem; cursor: pointer; transition: all 0.2s ease;
    }
    #legalInfoBtn:hover { color: #f59e0b; border-color: #f59e0b; background: rgba(245,158,11,0.1); }

    /* Szűrőgombok emoji/felirat része - mobilon csak az emoji marad */
    .btn-label { }
    .btn-icon { height: 1.1em; width: auto; vertical-align: middle; display: inline-block; }

    /* ============ ALSÓ INFÓSÁV ============ */
    .instruction-bar {
        position: absolute; bottom: 30px; left: 50%; transform: translateX(-50%);
        background: rgba(15, 23, 42, 0.85); backdrop-filter: blur(8px);
        color: #e2e8f0; padding: 12px 24px; border-radius: 30px; font-size: 0.9rem;
        border: 1px solid rgba(255,255,255,0.1); z-index: 400; pointer-events: none;
        max-width: 90%; text-align: center;
        transition: opacity 0.3s ease;
    }

    /* ============ 3D FÖLDGÖMB RÉTEG ============ */
    #globeLayer {
        position: absolute; inset: 0; z-index: 10;
        opacity: 1; transition: opacity 0.6s ease;
    }
    #globeLayer.hidden { opacity: 0; pointer-events: none; }
    #globeViz { width: 100%; height: 100vh; }

    /* ============ 2D TÉRKÉP RÉTEG ============ */
    #mapLayer {
        position: absolute; inset: 0; z-index: 20;
        opacity: 0; pointer-events: none; transition: opacity 0.6s ease;
    }
    #mapLayer.visible { opacity: 1; pointer-events: auto; }
    #mapViz { width: 100%; height: 100vh; background: #0f172a; }

    #layerToggle {
        display: none;
        position: absolute; top: 85px; left: 20px; z-index: 450;
        width: 44px; height: 44px; border-radius: 50%;
        background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(255,255,255,0.15);
        color: #e2e8f0; font-size: 1.2rem; cursor: pointer;
        backdrop-filter: blur(8px); box-shadow: 0 6px 16px -4px rgba(0,0,0,0.5);
        transition: all 0.2s ease;
    }
    #layerToggle:hover { border-color: #38bdf8; }
    #layerToggle.visible { display: block; }



    /* ============ EGYEDI LEAFLET MARKER ============ */
    .track-marker {
        width: 16px; height: 16px; border-radius: 50%;
        border: 2px solid #0f172a;
    }
    .track-marker.active { background: #22c55e; box-shadow: 0 0 8px rgba(34,197,94,0.8); }
    .track-marker.inactive { background: #d97706; box-shadow: 0 0 8px rgba(217,119,6,0.8); }
    .track-marker.unknown { background: #fde047; box-shadow: 0 0 10px rgba(253,224,71,0.95); }
    .track-marker.closed { background: #ef4444; box-shadow: 0 0 8px rgba(239,68,68,0.8); }

    /* ============ EGYEDI LEAFLET POPUP STÍLUS ============ */
    .leaflet-popup-content-wrapper {
        background: #0f172a; color: #e2e8f0; border-radius: 12px;
        border: 1px solid #334155; box-shadow: 0 10px 25px -5px rgba(0,0,0,0.6);
    }
    .leaflet-popup-tip { background: #0f172a; }
    .popup-card { min-width: 220px; max-width: 260px; position: relative; }
    .popup-flag { position: absolute; top: 0; right: 0; font-size: 1.4rem; line-height: 1; }
    .popup-status {
        position: absolute; top: 2px; left: 0; width: 12px; height: 12px; border-radius: 50%;
        border: 2px solid #0f172a; cursor: help;
    }
    .popup-status.active { background: #22c55e; box-shadow: 0 0 6px rgba(34,197,94,0.7); }
    .popup-status.inactive { background: #d97706; box-shadow: 0 0 6px rgba(217,119,6,0.7); }
    .popup-status.unknown { background: #fde047; box-shadow: 0 0 7px rgba(253,224,71,0.9); }
    .popup-status.closed { background: #ef4444; box-shadow: 0 0 6px rgba(239,68,68,0.7); }
    .popup-title { font-weight: 700; color: #ffffff; font-size: 0.95rem; margin-bottom: 8px; padding-right: 28px; padding-left: 18px; }
    .popup-tabs { display: flex; gap: 4px; margin-bottom: 8px; border-bottom: 1px solid #334155; }
    .popup-tab-btn {
        background: none; border: none; color: #64748b; font-size: 0.72rem; font-weight: 700;
        padding: 5px 8px; cursor: pointer; border-bottom: 2px solid transparent;
    }
    .popup-tab-btn.active { color: #38bdf8; border-bottom-color: #38bdf8; }
    .popup-tab-btn.disabled { color: #475569; cursor: not-allowed; opacity: 0.6; }
    .popup-tab-btn.disabled:hover { color: #475569; }
    .popup-tab-content { display: none; font-size: 0.8rem; color: #cbd5e1; line-height: 1.4; }
    .popup-tab-content.active { display: block; }
    .popup-row { margin-bottom: 4px; }
    .popup-row b { color: #e2e8f0; }
    .popup-row a { color: #38bdf8; text-decoration: none; }
    .popup-row a:hover { text-decoration: underline; }

    /* ================================================================
       MOBIL OPTIMALIZÁCIÓ
       ================================================================ */
    @media (max-width: 768px) {
        #siteFooter { display: none; } /* kis képernyőn elrejtjük, a jogi linkek a modal-on keresztül is elérhetők maradnak */
        #cookieBanner { padding: 12px 14px; flex-direction: column; align-items: stretch; }
        .cookie-text { max-width: 100%; font-size: 0.78rem; }
        .cookie-buttons { justify-content: stretch; }
        .cookie-btn { flex: 1; }
        .legal-box { padding: 20px; max-height: 85vh; }
        header { height: auto; min-height: 60px; padding: 6px 10px; padding-top: calc(env(safe-area-inset-top, 0) + 6px); flex-wrap: wrap; row-gap: 4px; }
        .logo-img { height: auto; width: 140px; max-width: 42vw; flex-shrink: 1; }
        .filter-container { gap: 2px; padding: 3px; }
        .filter-btn { padding: 8px 10px; font-size: 0.72rem; min-height: 40px; }
        .btn-label { display: none; } /* csak az emoji marad a Galopp/Ügető gombokon */
        .back-btn { padding: 8px 12px; font-size: 0.75rem; min-height: 40px; }
        #legalInfoBtn { width: 40px; height: 40px; } /* nagyobb érintési célpont mobilon */
        #langBtn, #hamburgerBtn { width: 40px; height: 40px; font-size: 1.05rem; }

        /* Legördülő menük: fix pozíció a viewporthoz képest, hogy a
           szűk, összenyomott fejléc-sor pozicionálása ne törje el őket */
        .dropdown-menu {
            position: fixed !important;
            top: calc(60px + env(safe-area-inset-top, 0) + 6px) !important;
            right: 10px !important;
            left: auto !important;
            max-width: calc(100vw - 20px);
        }

        .instruction-bar { bottom: 16px; font-size: 0.78rem; padding: 10px 16px; }

        /* Réteg-váltó (Műhold/Térkép): mobilon kisebb méret, sarokba igazítva */
        #layerToggle { top: 68px; left: 14px; width: 40px; height: 40px; font-size: 1.05rem; }

        /* (Az ország-panel szabályai eltávolítva: a pályalista a "Pályák" menübe került.) */

        .leaflet-control-zoom a { width: 40px !important; height: 40px !important; line-height: 40px !important; font-size: 1.1rem !important; }
        .leaflet-popup-content { margin: 10px 14px; max-width: 260px; }
    }

    @media (max-width: 380px) {
        .logo-img { height: auto; width: 112px; max-width: 38vw; }
        .filter-btn { padding: 7px 7px; font-size: 0.68rem; }
        .back-btn span.full-text { display: none; }
    }
    /* ================================================================
       COOKIE-BANNER
       ================================================================ */
    #cookieBanner {
        position: fixed; bottom: 0; left: 0; right: 0; z-index: 900;
        background: rgba(15, 23, 42, 0.97); backdrop-filter: blur(10px);
        border-top: 1px solid rgba(255,255,255,0.15);
        padding: 16px 20px; display: none;
        box-shadow: 0 -10px 30px -5px rgba(0,0,0,0.7);
    }
    #cookieBanner.visible { display: flex; }
    #cookieBanner {
        flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px;
    }
    .cookie-text { color: #cbd5e1; font-size: 0.85rem; max-width: 640px; line-height: 1.4; }
    .cookie-text a { color: #38bdf8; text-decoration: underline; cursor: pointer; }
    .cookie-buttons { display: flex; gap: 8px; flex-wrap: wrap; }
    .cookie-btn {
        border: none; border-radius: 20px; padding: 10px 18px; font-size: 0.82rem;
        font-weight: 700; cursor: pointer; white-space: nowrap;
    }
    .cookie-btn.reject { background: #475569; color: #ffffff; border: 2px solid #475569; }
    .cookie-btn.reject:hover { background: #334155; border-color: #334155; }
    .cookie-btn.accept { background: #38bdf8; color: #0f172a; border: 2px solid #38bdf8; }
    .cookie-btn.accept:hover { background: #0ea5e9; border-color: #0ea5e9; }

    /* ================================================================
       LÁBLÉC
       ================================================================ */
    #siteFooter {
        position: fixed; bottom: 0; left: 0; right: 0; z-index: 300;
        text-align: center; padding: 6px; font-size: 0.7rem; color: #64748b;
        pointer-events: none;
    }
    #siteFooter a { color: #94a3b8; pointer-events: auto; cursor: pointer; text-decoration: underline; margin: 0 6px; }

    /* ================================================================
       JOGI MODAL (Adatvédelem / Impresszum)
       ================================================================ */
    #legalModal, #infoModal {
        position: fixed; inset: 0; z-index: 1000; display: none;
        background: rgba(0,0,0,0.6); backdrop-filter: blur(4px);
        align-items: center; justify-content: center; padding: 20px;
    }
    #legalModal.visible, #infoModal.visible { display: flex; }
    .legal-box {
        background: #0f172a; border: 1px solid rgba(255,255,255,0.1); border-radius: 16px;
        max-width: 640px; width: 100%; max-height: 80vh; overflow-y: auto;
        padding: 28px; color: #e2e8f0; position: relative;
        box-shadow: 0 25px 50px -12px rgba(0,0,0,0.8);
    }
    .legal-box h2 { color: #f59e0b; margin-bottom: 12px; font-size: 1.2rem; }
    .legal-box h3 { color: #38bdf8; margin: 18px 0 6px; font-size: 1rem; }
    .legal-box p, .legal-box li { font-size: 0.85rem; line-height: 1.55; color: #cbd5e1; margin-bottom: 8px; }
    .legal-box ul { padding-left: 20px; }
    .legal-close {
        position: absolute; top: 16px; right: 16px; background: none; border: none;
        color: #94a3b8; font-size: 1.4rem; cursor: pointer; line-height: 1;
    }
    .legal-close:hover { color: #fff; }
    .legal-tabs { display: flex; gap: 6px; margin-bottom: 16px; border-bottom: 1px solid #334155; }
    .legal-tab-btn {
        background: none; border: none; color: #64748b; font-weight: 700; font-size: 0.85rem;
        padding: 8px 12px; cursor: pointer; border-bottom: 2px solid transparent;
    }
    .legal-tab-btn.active { color: #f59e0b; border-bottom-color: #f59e0b; }
    .legal-tab-content { display: none; }
    .legal-tab-content.active { display: block; }

    /* ================================================================
       PÁLYÁK BÖNGÉSZŐ (hamburger menü -> Pályák)
       Oldalról benyíló panel, hogy ne zavarja a térkép közepét
       ================================================================ */
    #tracksPanel {
        position: fixed; top: 0; right: 0; bottom: 0; width: 340px; max-width: 88vw;
        background: rgba(15, 23, 42, 0.97); backdrop-filter: blur(12px);
        border-left: 1px solid rgba(255,255,255,0.12); z-index: 800;
        transform: translateX(105%); transition: transform 0.35s ease;
        display: flex; flex-direction: column;
        box-shadow: -12px 0 40px -10px rgba(0,0,0,0.7);
    }
    #tracksPanel.open { transform: translateX(0); }
    .tp-head {
        display: flex; align-items: center; justify-content: space-between;
        padding: 16px 18px; border-bottom: 1px solid rgba(255,255,255,0.1);
        flex-shrink: 0;
    }
    .tp-title { color: #f59e0b; font-weight: 800; font-size: 1.05rem; }
    .tp-close {
        background: none; border: none; color: #94a3b8; font-size: 1.2rem;
        cursor: pointer; line-height: 1; padding: 4px 8px;
    }
    .tp-close:hover { color: #fff; }
    .tp-body { overflow-y: auto; padding: 10px 12px 24px; flex: 1; }
    .tp-body::-webkit-scrollbar { width: 6px; }
    .tp-body::-webkit-scrollbar-thumb { background: #334155; border-radius: 3px; }

    /* Ország sor (2. szint) */
    .tp-country {
        width: 100%; text-align: left; background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.07); border-radius: 10px;
        color: #e2e8f0; padding: 11px 13px; margin-bottom: 6px; cursor: pointer;
        font-size: 0.9rem; font-weight: 600; display: flex; align-items: center;
        justify-content: space-between; gap: 8px;
    }
    .tp-country:hover { background: rgba(56,189,248,0.12); border-color: #38bdf8; }
    .tp-count { color: #64748b; font-size: 0.75rem; font-weight: 500; }
    .tp-arrow { color: #64748b; font-size: 0.7rem; transition: transform 0.2s ease; }
    .tp-country.open .tp-arrow { transform: rotate(90deg); }

    /* Pályalista (3. szint) */
    .tp-tracks { display: none; padding: 2px 0 10px 10px; }
    .tp-tracks.open { display: block; }
    .tp-track {
        width: 100%; text-align: left; background: none; border: none;
        border-left: 2px solid rgba(255,255,255,0.1);
        color: #cbd5e1; padding: 9px 10px; cursor: pointer; font-size: 0.82rem;
        display: block; border-radius: 0 8px 8px 0;
    }
    .tp-track:hover { background: rgba(56,189,248,0.1); border-left-color: #38bdf8; color: #fff; }
    .tp-track .tp-tname { display: block; font-weight: 600; }
    .tp-track .tp-tmeta { display: block; color: #94a3b8; font-size: 0.72rem; margin-top: 2px; }

    /* Státusz jelölés: SZÍN + SZÖVEG együtt */
    .tp-status { display: inline-flex; align-items: center; gap: 5px; margin-top: 3px; font-size: 0.7rem; font-weight: 700; }
    .tp-dot { width: 8px; height: 8px; border-radius: 50%; display: inline-block; flex-shrink: 0; }
    .st-active .tp-dot { background: #22c55e; }
    .st-active { color: #22c55e; }
    .st-inactive .tp-dot { background: #d97706; }
    .st-inactive { color: #d97706; }
    .st-unknown .tp-dot { background: #fde047; }
    .st-unknown { color: #fde047; }
    .st-closed .tp-dot { background: #ef4444; }
    .st-closed { color: #ef4444; }

    /* ================================================================
       DUPLA IKON: nappali/éjszakai mód + térkép-réteg váltó
       ================================================================ */
    #dualToggle {
        position: absolute; bottom: 24px; left: 20px; z-index: 460;
        display: flex; border-radius: 24px; overflow: hidden;
        background: rgba(15, 23, 42, 0.9); backdrop-filter: blur(8px);
        border: 1px solid rgba(255,255,255,0.15);
        box-shadow: 0 8px 20px -6px rgba(0,0,0,0.6);
    }
    #dualToggle button {
        background: none; border: none; color: #e2e8f0; font-size: 1.05rem;
        width: 44px; height: 42px; cursor: pointer; transition: background 0.2s ease;
    }
    #dualToggle button:hover { background: rgba(245,158,11,0.18); }
    #dualToggle button + button { border-left: 1px solid rgba(255,255,255,0.15); }

    @media (max-width: 768px) {
        #tracksPanel { width: 100%; max-width: 100%; }
        #dualToggle { bottom: 68px; left: 14px; }
        #dualToggle button { width: 42px; height: 40px; }
    }
